<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Serenia Docs</title>
    <style>
      :root {
        --bg: #0d0e12;
        --surface: #13151b;
        --surface2: #1a1d26;
        --border: rgba(255, 255, 255, 0.08);
        --accent: #7c6af7;
        --accent2: #e05c7a;
        --text: #e8eaf0;
        --muted: #8b8fa8;
        --green: #3ecf8e;
        --nav-width: 220px;
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        background: var(--bg);
        color: var(--text);
        font-family: "Segoe UI", system-ui, sans-serif;
        font-size: 15px;
        line-height: 1.7;
      }

      /* Top bar */
      .topbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        height: 56px;
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 0 24px;
      }
      .topbar-logo {
        font-size: 18px;
        font-weight: 700;
        background: linear-gradient(90deg, var(--accent), var(--accent2));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -0.3px;
      }
      .topbar-links {
        margin-left: auto;
        display: flex;
        gap: 8px;
      }
      .topbar-links a {
        color: var(--muted);
        text-decoration: none;
        font-size: 13px;
        padding: 6px 14px;
        border-radius: 6px;
        border: 1px solid var(--border);
        transition:
          color 0.2s,
          border-color 0.2s;
      }
      .topbar-links a:hover {
        color: var(--text);
        border-color: rgba(255, 255, 255, 0.2);
      }
      .topbar-links a.invite {
        background: var(--accent);
        color: #fff;
        border-color: transparent;
      }
      .topbar-links a.invite:hover {
        opacity: 0.85;
      }

      /* Layout */
      .layout {
        display: flex;
        padding-top: 56px;
        min-height: 100vh;
      }

      /* Sidebar */
      nav.sidebar {
        position: fixed;
        top: 56px;
        left: 0;
        bottom: 0;
        width: var(--nav-width);
        background: var(--surface);
        border-right: 1px solid var(--border);
        overflow-y: auto;
        padding: 24px 0;
      }
      .nav-group {
        margin-bottom: 24px;
      }
      .nav-label {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
        padding: 0 20px 8px;
      }
      nav.sidebar a {
        display: block;
        padding: 7px 20px;
        color: var(--muted);
        text-decoration: none;
        font-size: 14px;
        border-left: 2px solid transparent;
        transition:
          color 0.15s,
          border-color 0.15s,
          background 0.15s;
      }
      nav.sidebar a:hover {
        color: var(--text);
        background: rgba(255, 255, 255, 0.04);
      }
      nav.sidebar a.active {
        color: var(--accent);
        border-left-color: var(--accent);
      }

      /* Main content */
      main {
        margin-left: var(--nav-width);
        flex: 1;
        padding: 48px 60px;
        max-width: calc(var(--nav-width) + 780px);
      }

      /* Sections */
      section {
        margin-bottom: 64px;
        scroll-margin-top: 80px;
      }
      section h1 {
        font-size: 26px;
        font-weight: 700;
        margin-bottom: 12px;
        color: var(--text);
      }
      section h2 {
        font-size: 16px;
        font-weight: 600;
        margin: 28px 0 8px;
        color: var(--text);
      }
      section p {
        color: var(--muted);
        margin-bottom: 10px;
      }
      section p a {
        color: var(--accent);
        text-decoration: none;
      }
      section p a:hover {
        text-decoration: underline;
      }

      /* Divider */
      .section-divider {
        border: none;
        border-top: 1px solid var(--border);
        margin-bottom: 64px;
      }

      /* Badge */
      .badge {
        display: inline-block;
        font-size: 11px;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 4px;
        margin-left: 8px;
        vertical-align: middle;
      }
      .badge-new {
        background: rgba(124, 106, 247, 0.18);
        color: var(--accent);
      }
      .badge-soon {
        background: rgba(224, 92, 122, 0.15);
        color: var(--accent2);
      }

      /* Code block */
      .code-block {
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 16px 20px;
        margin: 16px 0;
        font-family: "Cascadia Code", "Fira Code", monospace;
        font-size: 13px;
      }
      .code-block code {
        display: block;
        line-height: 2;
        color: #c9d1d9;
      }
      .code-block .step {
        color: var(--accent);
        font-weight: 600;
        margin-right: 6px;
      }

      /* Feature grid */
      .feature-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 12px;
        margin-top: 16px;
      }
      .feature-card {
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 16px;
      }
      .feature-card-title {
        font-size: 13px;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 4px;
      }
      .feature-card-desc {
        font-size: 12px;
        color: var(--muted);
        line-height: 1.5;
      }

      /* Policy list */
      .policy-list {
        list-style: none;
        margin-top: 8px;
      }
      .policy-list li {
        padding: 10px 0;
        border-bottom: 1px solid var(--border);
        font-size: 14px;
        color: var(--muted);
      }
      .policy-list li:last-child {
        border-bottom: none;
      }
      .policy-list li strong {
        color: var(--text);
      }

      /* Callout */
      .callout {
        background: rgba(62, 207, 142, 0.08);
        border-left: 3px solid var(--green);
        border-radius: 0 8px 8px 0;
        padding: 12px 16px;
        margin: 16px 0;
        font-size: 14px;
        color: var(--muted);
      }

      /* Hero */
      .hero {
        margin-bottom: 48px;
      }
      .hero h1 {
        font-size: 38px;
        font-weight: 800;
        letter-spacing: -0.5px;
        background: linear-gradient(90deg, #fff 40%, var(--muted));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 12px;
        line-height: 1.2;
      }
      .hero p {
        font-size: 16px;
        max-width: 540px;
      }

      /* Footer */
      footer {
        margin-left: var(--nav-width);
        padding: 32px 60px;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 13px;
      }

      @media (max-width: 768px) {
        nav.sidebar {
          display: none;
        }
        main {
          margin-left: 0;
          padding: 24px 20px;
        }
        footer {
          margin-left: 0;
          padding: 24px 20px;
        }
        .hero h1 {
          font-size: 28px;
        }
      }
    </style>
  </head>
  <body>
    <div class="topbar">
      <span class="topbar-logo">Serenia</span>
      <div class="topbar-links">
        <a href="https://discord.gg/FqdH4sfKBg" target="_blank">Discord</a>
        <a href="#" target="_blank">Commands</a>
        <a
          class="invite"
          href="https://discord.com/oauth2/authorize?client_id=767705905235099658&scope=bot&permissions=490073207"
          target="_blank"
          >Invite</a
        >
      </div>
    </div>

    <div class="layout">
      <nav class="sidebar">
        <div class="nav-group">
          <div class="nav-label">Overview</div>
          <a href="#about">About</a>
          <a href="#developer">Developer</a>
        </div>
        <div class="nav-group">
          <div class="nav-label">Features</div>
          <a href="#moderation">Moderation</a>
          <a href="#information">Information</a>
          <a href="#fun">Fun</a>
          <a href="#utilities">Utilities</a>
          <a href="#game">Game</a>
          <a href="#currency">Currency</a>
          <a href="#leveling">Leveling</a>
          <a href="#images">Image Commands</a>
        </div>
        <div class="nav-group">
          <div class="nav-label">Reference</div>
          <a href="#shards">Shards</a>
          <a href="#faq">FAQ</a>
          <a href="#ban_policy">Ban Policy</a>
          <a href="#blacklist_policy">Economy Blacklist</a>
        </div>
      </nav>

      <main>
        <div class="hero">
          <h1>Serenia Documentation</h1>
          <p style="color: var(--muted)">
            Everything you need to know about setting up and using Serenia in
            your Discord server.
          </p>
        </div>

        <section id="about">
          <h1>About</h1>
          <p>
            Serenia aims to be an incredibly unique bot. The goal is to have
            every feature you could ever think of — from moderation and economy
            to games, leveling, and image commands. The overall vision is to
            provide a quality product that grows alongside your community.
          </p>
        </section>

        <hr class="section-divider" />

        <section id="developer">
          <h1>Developer</h1>
          <p>
            Serenia was built by a single developer. The idea has always been to
            build something unique — not just another cookie-cutter bot.
            Development started during the 2020 quarantine and has been growing
            ever since.
          </p>
          <p>
            You can support development by inviting the bot to your server, or
            by picking up the <a href="#">premium version</a>.
          </p>
        </section>

        <hr class="section-divider" />

        <section id="moderation">
          <h1>Moderation</h1>

          <h2>Verification system</h2>
          <p>Set up a member verification flow in three steps:</p>
          <div class="code-block">
            <code
              ><span class="step">1.</span>setverificationchannel #channel</code
            >
            <code><span class="step">2.</span>setverificationrole @role</code>
            <code
              ><span class="step">3.</span>setverificationmessage
              &lt;message&gt;</code
            >
          </div>

          <h2>Ban &amp; ban waves</h2>
          <p>
            Ban individual members or run a ban wave — banning multiple users at
            once — all within the same prefix command. For a soft ban, the
            member's messages are deleted before they're removed, and you can
            unban directly afterwards.
          </p>

          <h2>Auto role</h2>
          <p>
            Automatically assigns a specified role to every new member when they
            join the server.
          </p>

          <h2>Lock and unlock channel</h2>
          <p>
            Instantly lock a channel to stop disruption, then unlock it whenever
            you're ready.
          </p>

          <h2>Advanced warnings</h2>
          <p>
            Warn users with a full log (including date and reason). The auto
            kick command can automatically remove any member who reaches a set
            number of warns. Warn logs can be reviewed or cleared at any time.
          </p>

          <h2>Advanced logging</h2>
          <div class="feature-grid">
            <div class="feature-card">
              <div class="feature-card-title">Deleted messages</div>
              <div class="feature-card-desc">
                Logs all deleted messages to your log channel.
              </div>
            </div>
            <div class="feature-card">
              <div class="feature-card-title">Edited messages</div>
              <div class="feature-card-desc">
                Records before and after for any edited message.
              </div>
            </div>
            <div class="feature-card">
              <div class="feature-card-title">Nickname changes</div>
              <div class="feature-card-desc">
                Tracks every nickname update by member.
              </div>
            </div>
            <div class="feature-card">
              <div class="feature-card-title">Member activity</div>
              <div class="feature-card-desc">
                Logs joins, leaves, and kicks.
              </div>
            </div>
            <div class="feature-card">
              <div class="feature-card-title">Role changes</div>
              <div class="feature-card-desc">
                Logs roles added or removed from members.
              </div>
            </div>
          </div>

          <h2>Disable mentions</h2>
          <p>
            When enabled, Serenia deletes every ping directed at you and
            automatically warns the sender. The feature disables itself as soon
            as you send a message in any channel.
          </p>

          <h2>Welcome &amp; leave messages</h2>
          <p>
            Configure custom welcome and leave messages for your server with
            ease.
          </p>

          <h2>Purge</h2>
          <p>
            Delete a specified number of messages from any channel. Also works
            alongside the warn purge command.
          </p>

          <h2>Other commands</h2>
          <p>Includes: setnickname, slowmode, mute, addrole, removerole.</p>
        </section>

        <hr class="section-divider" />

        <section id="information">
          <h1>Information</h1>
          <h2>Detailed server info</h2>
          <p>
            Fetch a full breakdown of any channel, server, member, or role — all
            in a clean, readable format.
          </p>
        </section>

        <hr class="section-divider" />

        <section id="fun">
          <h1>Fun</h1>
          <h2>Fact commands</h2>
          <p>Includes random facts, dog facts, cat facts, and more.</p>
          <h2>Jokes</h2>
          <p>Address a friend with a yomomma joke, a hack, or a kill.</p>
        </section>

        <hr class="section-divider" />

        <section id="utilities">
          <h1>Utilities</h1>
          <h2>Tickets</h2>
          <p>
            Members can create and close support tickets. A default 24-hour
            cooldown prevents ticket spam.
          </p>
          <h2>Reminders</h2>
          <p>Set a reminder and Serenia will ping you when the time comes.</p>
          <h2>TikTok stats</h2>
          <p>Look up detailed statistics for any TikTok user.</p>
          <h2>AFK</h2>
          <p>
            Set an AFK message that shows automatically whenever someone pings
            you.
          </p>
          <h2>Thank</h2>
          <p>
            Thank any user who helped you — limited to once every 12 hours to
            avoid DM spam.
          </p>
        </section>

        <hr class="section-divider" />

        <section id="game">
          <h1>Game</h1>
          <h2>Hangman</h2>
          <p>Play a group game of hangman in any channel.</p>
          <h2>TicTacToe</h2>
          <p>Challenge any user to a game of TicTacToe.</p>
          <h2>Other</h2>
          <p>Includes: trivia, slots, diceroll, and 8ball.</p>
        </section>

        <hr class="section-divider" />

        <section id="currency">
          <h1>Currency</h1>
          <h2>Earning money</h2>
          <p>
            Use the beg, search, and work commands to earn coins. Collect your
            daily, weekly, and monthly rewards for consistent bonuses on top of
            that.
          </p>

          <h2>Buying &amp; upgrading</h2>
          <p>
            Visit the shop to buy an apartment, then upgrade it over time to
            increase your passive earnings.
          </p>

          <h2>Safe mode</h2>
          <p>Protect your balance by enabling safe mode. While active:</p>
          <ul class="policy-list">
            <li>Padlocks, banknotes, and laptops cannot be used</li>
            <li>No shop purchases</li>
            <li>Apartments and collectibles cannot be collected</li>
            <li>Daily rewards are disabled</li>
            <li>Beg and search cooldowns are doubled</li>
            <li>No roulette or betting</li>
          </ul>
          <div class="callout">
            Safe mode can only be disabled after 12 hours once enabled.
          </div>
        </section>

        <hr class="section-divider" />

        <section id="leveling">
          <h1>Leveling <span class="badge badge-new">New</span></h1>
          <h2>Level system</h2>
          <p>
            Serenia includes a full leveling system that tracks member activity
            and rewards progression over time.
          </p>
          <h2>Level roles</h2>
          <p>
            Assign roles automatically when members hit certain levels. Stacking
            is optional — you can choose whether members keep lower-level roles
            as they rank up, or only hold their current one.
          </p>
          <div
            class="callout"
            style="
              border-left-color: var(--accent2);
              background: rgba(224, 92, 122, 0.07);
            "
          >
            A dedicated commands page for the leveling system is coming soon.
          </div>
        </section>

        <hr class="section-divider" />

        <section id="images">
          <h1>Image commands <span class="badge badge-new">New</span></h1>
          <p>
            Serenia can generate and display images directly in your server. Use
            image commands to pull up visuals on demand — great for fun,
            reactions, or content in your channels.
          </p>
        </section>

        <hr class="section-divider" />

        <section id="shards">
          <h1>Shards</h1>
          <h2>How sharding works</h2>
          <p>
            As Serenia grows and joins more servers, it automatically splits
            into multiple shards to handle the load. Those shards are then
            grouped together into clusters, keeping everything running smoothly
            regardless of scale. This all happens behind the scenes — you won't
            need to do anything on your end.
          </p>
        </section>

        <hr class="section-divider" />

        <section id="faq">
          <h1>FAQ</h1>
          <p>
            No questions have been submitted yet. If you have one, reach out on
            <a href="https://discord.gg/FqdH4sfKBg" target="_blank">Discord</a>.
          </p>
        </section>

        <hr class="section-divider" />

        <section id="ban_policy">
          <h1>Ban policy</h1>
          <p>
            A full overview of what gets users banned from Serenia, and how to
            report violations.
          </p>

          <h2>Spam</h2>
          <ul class="policy-list">
            <li>
              Spamming in a channel not explicitly marked as a spam channel
            </li>
            <li>Organizing or participating in a server raid</li>
            <li>Spamming another user's direct messages</li>
          </ul>

          <h2>NSFW</h2>
          <ul class="policy-list">
            <li>Sending NSFW content to another user via DM without consent</li>
            <li>Intentionally posting NSFW content in a non-NSFW channel</li>
          </ul>

          <h2>Toxicity</h2>
          <ul class="policy-list">
            <li>Being rude or toxic toward other users</li>
            <li>Disobeying instructions from server staff</li>
          </ul>

          <div class="callout">
            To report a violation, gather screenshot evidence and the offending
            user's ID, then contact us via
            <a
              href="https://discord.gg/FqdH4sfKBg"
              target="_blank"
              style="color: var(--green)"
              >Discord</a
            >. We'll review the submission and make a decision.
          </div>
        </section>

        <hr class="section-divider" />

        <section id="blacklist_policy">
          <h1>Economy blacklist policy</h1>
          <ul class="policy-list">
            <li>
              <strong>No account hiding:</strong> You cannot store money in an
              alt account to hide it in another server.
            </li>
            <li>
              <strong>No automation:</strong> Using macros or bots to repeatedly
              send economy commands (e.g. running !beg every 2 minutes) is
              forbidden.
            </li>
            <li>
              <strong>No sharing exploits:</strong> If you find an exploit in
              the currency system, report it — don't share it. Reports may be
              rewarded.
            </li>
            <li>
              <strong>No alt farming:</strong> Transferring money to an alt to
              get top items or avoid cooldowns is not allowed. Playing with a
              real friend is fine.
            </li>
            <li>
              <strong>No black market:</strong> Selling in-game coins for real
              money is against both Serenia rules and Discord's Terms of
              Service.
            </li>
          </ul>

          <div class="callout">
            To report an economy violation, gather evidence and the user's ID,
            then reach out via
            <a
              href="https://discord.gg/FqdH4sfKBg"
              target="_blank"
              style="color: var(--green)"
              >Discord</a
            >.
          </div>
        </section>
      </main>
    </div>

    <footer>
      Copyright © 2026 Serenia. All rights reserved. &nbsp;·&nbsp;
      <a
        href="https://discord.gg/FqdH4sfKBg"
        target="_blank"
        style="color: var(--accent)"
        >Discord</a
      >
    </footer>

    <script>
      const links = document.querySelectorAll("nav.sidebar a");
      const sections = document.querySelectorAll("section[id]");

      function onScroll() {
        let current = "";
        sections.forEach((s) => {
          if (window.scrollY >= s.offsetTop - 100) current = s.id;
        });
        links.forEach((l) => {
          l.classList.toggle(
            "active",
            l.getAttribute("href") === "#" + current,
          );
        });
      }

      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>
